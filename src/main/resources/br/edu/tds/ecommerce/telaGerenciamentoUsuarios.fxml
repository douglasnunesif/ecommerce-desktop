<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.tds.ecommerce.TelaGerenciamentoUsuariosController">
   <top>
      <HBox alignment="CENTER" prefHeight="57.0" prefWidth="700.0" style="-fx-background-color: #0598ff;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="60.0">
               <children>
                  <Button mnemonicParsing="false" style="-fx-background-color: transparent;">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="fas-arrow-left" iconSize="30" selectionEnd="1" />
                     </graphic></Button>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="580.0">
               <children>
                  <Label alignment="CENTER" prefHeight="43.0" prefWidth="392.0" style="-fx-background-color: #0598ff; -fx-font-size: 20; -fx-font-weight: 800;" text="Gerenciamento de Usuarios" textFill="#fcfcfc" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="60.0">
               <children>
                  <Button mnemonicParsing="false" style="-fx-background-color: transparent;">
                     <graphic>
                        <FontIcon fill="WHITE" iconColor="WHITE" iconLiteral="fas-window-close" iconSize="30" />
                     </graphic></Button>
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER" prefHeight="63.0" prefWidth="680.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#abrirTelaCadastroUsuario" style="-fx-background-color: #0598ff;" text="+ Novo">
               <textFill>
                  <RadialGradient centerX="0.5" centerY="0.5" radius="0.5">
                     <stops>
                        <Stop>
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Stop>
                     </stops>
                  </RadialGradient>
               </textFill>
            </Button>
            <Button mnemonicParsing="false" onAction="#editarUsuario" style="-fx-background-color: #ffa500;" text="| Editar" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#excluirUsuario" style="-fx-background-color: #ff4d4d;" text="x Excluir" textFill="WHITE" />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
   <center>
      <TableView fx:id="tabelaUsuarios" prefHeight="299.0" prefWidth="700.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colNomeCompleto" prefWidth="268.0" text="Nome Completo" />
          <TableColumn fx:id="colUsuario" minWidth="0.0" prefWidth="129.0" text="Usuario" />
            <TableColumn fx:id="colEmail" prefWidth="195.0" text="E-mail" />
            <TableColumn fx:id="colCPF" prefWidth="107.0" text="CPF" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
